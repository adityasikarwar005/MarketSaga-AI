# Copy to .env and fill in. NEVER commit .env.
MARKETSAGE_ENV=research

# Broker credentials - only ever set in paper/live environments.
# The research env refuses to load them (libs/ms_core/env.py).
# KITE_API_KEY=
# KITE_API_SECRET=
# Redirect URL to configure in the Kite developer console:
#   http://127.0.0.1:5000/callback

# Second of the two live-arming signals. The other is a .live-armed file.
# MARKETSAGE_LIVE_ARMED=1
